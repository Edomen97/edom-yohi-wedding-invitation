import bcrypt from "bcryptjs";

const password = process.argv[2];
if (!password || password.length < 10) {
  console.error("Usage: npm run hash-password \"YourStrongPassword\" (min 10 chars)");
  process.exit(1);
}
const hash = await bcrypt.hash(password, 12);
console.log("\nPaste this into Render → Environment → ADMIN_PASSWORD_HASH:\n");
console.log(hash + "\n");